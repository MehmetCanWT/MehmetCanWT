# ==============================================================================
# MEHMETCANWT LIVE ARCHIVE - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in the values
# ==============================================================================

# Authentication & Security
ADMIN_PASSWORD="your_admin_password_here"
JWT_SECRET="your_secure_256bit_random_jwt_secret"

# Cloud Database & Redis
DATABASE_URL="postgresql://user:password@localhost:5432/mehmetcanwt?sslmode=require"
DB_SSL="true"
REDIS_URL="redis://default:password@localhost:6379"

# Steam Web API Integration
STEAM_ID="your_steam_id_64"
WEB_KEY="your_steam_web_api_key_from_steamcommunity"

# Discord Telemetry (Lanyard)
DISCORD_ID="your_discord_id"
LANYARD_API_KEY=""

# Networking & CORS
DOMAIN="your_domain_here"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
NODE_ENV="production"
